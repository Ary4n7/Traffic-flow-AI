# ── State Initialization ──────────────────────────────────────────────────────
@st.cache_resource
def load_cached_predictor():
    try:
        return SpilloverPredictor()
    except Exception as e:
        st.error(f"Error loading predictor: {e}. Please ensure models and data exist.")
        return None

@st.cache_resource
def load_cached_simulator(_predictor):
    try:
        return TrafficSimulator(predictor=_predictor)
    except Exception as e:
        st.error(f"Error loading simulator: {e}")
        return None

@st.cache_resource
def load_cached_propagation_engine():
    try:
        return PropagationDirectionEngine()
    except Exception as e:
        st.warning(f"Propagation engine loaded with defaults: {e}")
        return None

@st.cache_data
def load_all_artifacts():
    metrics = None
    meta = None
    prop_data = None
    lead_time_data = None
    cal_data = None
    ablation_data = None
    stress_data = None
    multi_horizon_data = None
    threshold_data = None
    regime_data = None
    prop_val_data = None
    
    if os.path.exists(config.METRICS_JSON):
        with open(config.METRICS_JSON, "r") as f:
            metrics = json.load(f)
    if os.path.exists(config.FEATURE_META_JSON):
        with open(config.FEATURE_META_JSON, "r") as f:
            meta = json.load(f)
    if os.path.exists(config.PROPAGATION_JSON):
        with open(config.PROPAGATION_JSON, "r") as f:
            prop_data = json.load(f)
    if os.path.exists(config.LEAD_TIME_METRICS_JSON):
        with open(config.LEAD_TIME_METRICS_JSON, "r") as f:
            lead_time_data = json.load(f)
    if os.path.exists(getattr(config, "CALIBRATION_JSON", "")):
        with open(config.CALIBRATION_JSON, "r") as f:
            cal_data = json.load(f)
    if os.path.exists(getattr(config, "ABLATION_JSON", "")):
        with open(config.ABLATION_JSON, "r") as f:
            ablation_data = json.load(f)
    if os.path.exists(getattr(config, "STAGE4_STRESS_TEST_JSON", "")):
        with open(config.STAGE4_STRESS_TEST_JSON, "r") as f:
            stress_data = json.load(f)
    elif os.path.exists(getattr(config, "STRESS_TEST_JSON", "")):
        with open(config.STRESS_TEST_JSON, "r") as f:
            stress_data = json.load(f)
    if os.path.exists(getattr(config, "MULTI_HORIZON_METRICS_JSON", "")):
        with open(config.MULTI_HORIZON_METRICS_JSON, "r") as f:
            multi_horizon_data = json.load(f)
    if os.path.exists(getattr(config, "THRESHOLD_ANALYSIS_JSON", "")):
        with open(config.THRESHOLD_ANALYSIS_JSON, "r") as f:
            threshold_data = json.load(f)
    if os.path.exists(getattr(config, "TEMPORAL_REGIME_JSON", "")):
        with open(config.TEMPORAL_REGIME_JSON, "r") as f:
            regime_data = json.load(f)
    if os.path.exists(getattr(config, "PROPAGATION_VALIDATION_JSON", "")):
        with open(config.PROPAGATION_VALIDATION_JSON, "r") as f:
            prop_val_data = json.load(f)
            
    return (
        metrics, meta, prop_data, lead_time_data, cal_data,
        ablation_data, stress_data, multi_horizon_data,
        threshold_data, regime_data, prop_val_data
    )

@st.cache_data
def get_graph_layout():
    """Compute and cache fixed 2D layout for the 207-node sensor network."""
    with open(config.ADJACENCY_PKL, "rb") as f:
        G = pickle.load(f)
    pos = nx.spring_layout(G, seed=42, k=0.18, iterations=60)
    return G, pos


predictor = load_cached_predictor()
simulator = load_cached_simulator(predictor)
prop_engine = load_cached_propagation_engine()
(
    metrics_data, meta_data, prop_data, lead_time_data, cal_data,
    ablation_data, stress_data, multi_horizon_data,
    threshold_data, regime_data, prop_val_data
) = load_all_artifacts()
G_network, graph_pos = get_graph_layout()

# Session state
if "sim_running" not in st.session_state:
    st.session_state.sim_running = False
if "sim_data" not in st.session_state:
    st.session_state.sim_data = simulator.step()
if "selected_road" not in st.session_state:
    st.session_state.selected_road = list(G_network.nodes())[0]


