                    "Mean Lead Time": f"{r_v['mean_lead_time_min']} min",
                })
            st.dataframe(pd.DataFrame(reg_rows), use_container_width=True, hide_index=True)
            
    # ── TAB 4: Hardware Stress Tests ───────────────────────────────────────────
    with t_stress:
        st.markdown("### ⚡ Sensor Outage & Hardware Stress Tests")
        st.markdown("Empirical stress simulation evaluating 0%, 5%, 10%, 20%, 30% sensor dropouts, localized regional blackouts, and sporadic packet loss.")
        
        if stress_data:
            stress_res = stress_data["stress_results"]
            stress_rows = []
            for cond, vals in stress_res.items():
                stress_rows.append({
                    "Outage Condition": cond,
                    "Sensors Disabled": f"{vals.get('sensors_disabled_count', 0)} / 207",
                    "Accuracy": f"{vals['accuracy']*100:.2f}%",
                    "Precision": f"{vals['precision']*100:.2f}%",
                    "Recall": f"{vals['recall']*100:.2f}%",
                    "F1-Score": f"{vals['f1_score']*100:.2f}%",
                    "ROC-AUC": f"{vals['roc_auc']*100:.2f}%",
                    "Advance Warning Rate": f"{vals.get('advance_warning_rate_pct', 'N/A')}%",
                    "Mean Lead Time": f"{vals.get('mean_lead_time_min', 'N/A')} min",
                    "F1 Degradation": f"{vals['f1_degradation_pct']}%",
                    "Resilience Status": vals["system_resilience_status"],
                })
            st.dataframe(pd.DataFrame(stress_rows), use_container_width=True, hide_index=True)
            
    # ── TAB 5: Propagation TLCC Validation ────────────────────────────────────
    with t_prop:
        st.markdown("### 🧭 Empirical TLCC Propagation Validation & Stability")
        st.markdown("Verifying temporal cross-period stability and loop-free cascade integrity.")
        
        if prop_val_data:
            p_meta = prop_val_data["engine_summary"]
            p_stab = prop_val_data["stability_analysis"]
            p_casc = prop_val_data["cascade_integrity"]
            
            pk1, pk2, pk3 = st.columns(3)
            with pk1:
                st.metric("Cross-Period Stability", f"{p_stab['cross_period_stability_rate_pct']}%")
            with pk2:
                st.metric("Loop-Cycle Violations", p_casc["loop_cycle_violations"])
            with pk3:
                st.metric("Monotonicity Violations", p_casc["monotonicity_violations"])
                
            st.markdown("---")
            st.markdown(f"""
            - **Temporal Stability:** `{p_stab['consistent_edges_count']} of {p_stab['consistent_edges_count'] + p_stab['inconsistent_edges_count']}` edges maintain identical directional inference between chronological training halves.
            - **Cascade Graph Status:** `{p_casc['cascade_integrity_status']}` across all 207 starting highway nodes.
            - **Honesty Rule:** Directionally uncertain relationships remain explicitly labeled as `"Graph neighbor — direction uncertain"` with zero forced physical assumptions.
            """)
            
    # ── TAB 6: Probability Calibration ─────────────────────────────────────────
    with t_cal:
        st.markdown("### 🎯 Validation-Driven Probability Calibration")
        st.markdown("Probability calibration aligns model risk outputs with empirical observation frequencies, eliminating raw tree overconfidence.")
        
        if cal_data:
            c_perf = cal_data["test_set_performance"]
            k1, k2, k3 = st.columns(3)
            with k1:
                st.markdown(f'<div class="kpi-card"><div class="kpi-label">Brier Score Loss</div><div class="kpi-value" style="color:#22C55E;">{c_perf["calibrated"]["brier_score"]}</div><div style="font-size:0.8rem;color:#94A3B8">Raw RF: {c_perf["raw_rf"]["brier_score"]} ({c_perf["calibrated"]["brier_improvement_pct"]}% better)</div></div>', unsafe_allow_html=True)
            with k2:
                st.markdown(f'<div class="kpi-card"><div class="kpi-label">Expected Calibration Error (ECE)</div><div class="kpi-value" style="color:#00F2FE;">{c_perf["calibrated"]["ece"]}</div><div style="font-size:0.8rem;color:#94A3B8">Raw RF: {c_perf["raw_rf"]["ece"]} ({c_perf["calibrated"]["ece_improvement_pct"]}% reduction)</div></div>', unsafe_allow_html=True)
            with k3:
                st.markdown(f'<div class="kpi-card"><div class="kpi-label">Calibrated Precision</div><div class="kpi-value" style="color:#818CF8;">{c_perf["calibrated"]["precision"]*100:.1f}%</div><div style="font-size:0.8rem;color:#94A3B8">Raw RF: {c_perf["raw_rf"]["precision"]*100:.1f}% (+{round((c_perf["calibrated"]["precision"]-c_perf["raw_rf"]["precision"])*100, 1)}%)</div></div>', unsafe_allow_html=True)
                
            st.markdown("<br>", unsafe_allow_html=True)
            rc = cal_data["reliability_curves"]
            fig_cal = go.Figure()
            fig_cal.add_trace(go.Scatter(x=[0, 1], y=[0, 1], mode="lines", name="Perfect Calibration", line=dict(dash="dash", color="#64748B")))
            fig_cal.add_trace(go.Scatter(x=rc["raw_rf"]["mean_predicted_value"], y=rc["raw_rf"]["fraction_of_positives"], mode="lines+markers", name="Raw Random Forest", line=dict(color="#F87171", width=2), marker=dict(size=7)))
            fig_cal.add_trace(go.Scatter(x=rc["calibrated"]["mean_predicted_value"], y=rc["calibrated"]["fraction_of_positives"], mode="lines+markers", name="Calibrated Model (Isotonic)", line=dict(color="#38BDF8", width=3), marker=dict(size=8)))
            fig_cal.update_layout(
                title="Reliability / Calibration Curves on Chronological Test Set",
                xaxis=dict(title="Mean Predicted Probability", range=[0, 1]),
                yaxis=dict(title="Observed Fraction of Congestion Positives", range=[0, 1]),
                plot_bgcolor="#1E293B", paper_bgcolor="#1E293B", font=dict(color="#F8FAFC"),
                height=350,
            )
            st.plotly_chart(fig_cal, use_container_width=True)
            
    # ── TAB 7: Ablation Study ──────────────────────────────────────────────────
    with t_abl:
        st.markdown("### 🏗️ Architectural Ablation Benchmark Suite")
        st.markdown("Comparing progressive architectures evaluated on chronological test set observations.")
        
        if ablation_data:
