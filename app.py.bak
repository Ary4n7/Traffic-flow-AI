# VIEW 1: LIVE EARLY WARNING CENTER
# ═══════════════════════════════════════════════════════════════════════════════
if nav_option == "🌐 Live Early Warning Center":
    st.markdown('<div class="main-header">Real-Time Spatiotemporal Warning Center</div>', unsafe_allow_html=True)
    st.markdown('<div class="sub-header">Operational 5-State Alert Command Center with Debounced Alert Hysteresis & Shockwave Telemetry.</div>', unsafe_allow_html=True)
    
    # Live controls
    ctrl_col1, ctrl_col2, ctrl_col3, ctrl_col4 = st.columns([2, 1, 1, 2])
    with ctrl_col1:
        regime = st.selectbox("Telemetry Regime", ["Normal Highway Flow", "Morning Commute Rush", "Evening Commute Rush", "High-Incident Stress"])
    with ctrl_col2:
        if st.button("▶ Next Timestep (+5m)", use_container_width=True):
            regime_map = {
                "Normal Highway Flow": "normal",
                "Morning Commute Rush": "morning_rush",
                "Evening Commute Rush": "evening_rush",
                "High-Incident Stress": "incident",
            }
            st.session_state.sim_data = simulator.step(regime=regime_map.get(regime, "normal"))
    with ctrl_col3:
        if st.button("↺ Reset Network", use_container_width=True):
            simulator.reset()
            st.session_state.sim_data = simulator.step()
    with ctrl_col4:
        show_arrows = st.checkbox("Highlight Probable Propagation Paths", value=True)
        
    sim_data = st.session_state.sim_data
    df_preds = sim_data.get("ai_predictions")
    
    # State counts
    if df_preds is not None:
        state_counts = df_preds["early_warning_state"].value_counts().to_dict()
        n_crit = state_counts.get("CRITICAL", 0)
        n_high = state_counts.get("HIGH RISK", 0)
        n_warn = state_counts.get("WARNING", 0)
        n_watch = state_counts.get("WATCH", 0)
        n_norm = state_counts.get("NORMAL", 0)
        
        k1, k2, k3, k4, k5 = st.columns(5)
        with k1:
            st.markdown(f'<div class="kpi-card" style="border-top:3px solid #EF4444"><div class="kpi-label">CRITICAL</div><div class="kpi-value" style="color:#EF4444">{n_crit}</div><div style="font-size:0.8rem;color:#94A3B8">Congested / Extreme Risk</div></div>', unsafe_allow_html=True)
        with k2:
            st.markdown(f'<div class="kpi-card" style="border-top:3px solid #F97316"><div class="kpi-label">HIGH RISK</div><div class="kpi-value" style="color:#F97316">{n_high}</div><div style="font-size:0.8rem;color:#94A3B8">Imminent Threat (70-85%)</div></div>', unsafe_allow_html=True)
        with k3:
            st.markdown(f'<div class="kpi-card" style="border-top:3px solid #F59E0B"><div class="kpi-label">WARNING</div><div class="kpi-value" style="color:#F59E0B">{n_warn}</div><div style="font-size:0.8rem;color:#94A3B8">Sharp Decel (50-70%)</div></div>', unsafe_allow_html=True)
        with k4:
            st.markdown(f'<div class="kpi-card" style="border-top:3px solid #EAB308"><div class="kpi-label">WATCH</div><div class="kpi-value" style="color:#EAB308">{n_watch}</div><div style="font-size:0.8rem;color:#94A3B8">Early Decay (30-50%)</div></div>', unsafe_allow_html=True)
        with k5:
            st.markdown(f'<div class="kpi-card" style="border-top:3px solid #22C55E"><div class="kpi-label">NORMAL</div><div class="kpi-value" style="color:#22C55E">{n_norm}</div><div style="font-size:0.8rem;color:#94A3B8">Stable Highway Flow</div></div>', unsafe_allow_html=True)
            
    st.markdown("<br>", unsafe_allow_html=True)
    
    # Main graph
    col_graph, col_feed = st.columns([3, 2])
    with col_graph:
        st.markdown(f"**Network Graph State @ {sim_data['timestamp'].strftime('%Y-%m-%d %H:%M')}**")
        fig_net = render_network_graph(df_preds, show_directional_edges=show_arrows)
        st.plotly_chart(fig_net, use_container_width=True)
        
    with col_feed:
        st.markdown("#### 🚨 Priority Early-Warning Escalation Feed")
        if df_preds is not None:
            alert_df = df_preds[df_preds["early_warning_state"].isin(["CRITICAL", "HIGH RISK", "WARNING"])].sort_values("congestion_probability", ascending=False).head(8)
            if len(alert_df) == 0:
                st.markdown('<div class="alert-banner-safe"><b>✓ Network Nominal:</b> All 207 highway segments stable. Spatiotemporal risk engine continuously monitoring telemetry.</div>', unsafe_allow_html=True)
            else:
                for _, row in alert_df.iterrows():
                    state = row["early_warning_state"]
                    s_id = row["road_id"]
                    spd = row["current_speed"]
                    p = row["congestion_probability"]
                    d10 = row["speed_delta_10"]
                    trm = row["TRM"]
                    scp = row["SCP"]
                    psi = row["PSI"]
                    
                    banner_cls = "alert-banner-critical" if state in ["CRITICAL", "HIGH RISK"] else "alert-banner-warning"
                    st.markdown(f"""
                    <div class="{banner_cls}">
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <b>Segment {s_id}</b>
                            <span class="metric-pill" style="background:{row['early_warning_color']};color:#000;">{state}</span>
                        </div>
                        <div style="font-size:0.88rem;margin-top:4px;">
                            Speed: <b>{spd:.1f} mph</b> ({d10:+.1f} mph 10m) | Fused Risk: <b>{p*100:.1f}%</b>
                        </div>
                        <div style="font-size:0.78rem;color:#CBD5E1;margin-top:3px;">
                            TRM Momentum: {trm:.2f} | SCP Pressure: {scp:.2f} | PSI Shock: {psi:.2f}
                        </div>
                    </div>
                    """, unsafe_allow_html=True)


