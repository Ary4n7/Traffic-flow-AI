elif nav_option == "🚨 Run Spillover & Cascade Demo":
    st.markdown('<div class="main-header">Congestion Spillover & Cascade Simulator</div>', unsafe_allow_html=True)
    st.markdown('<div class="sub-header">Induce synthetic bottleneck deceleration and track multi-hop shockwave propagation.</div>', unsafe_allow_html=True)
    
    sim_data = st.session_state.sim_data
    df_preds = sim_data.get("ai_predictions")
    sensors = list(G_network.nodes())
    
    col_c1, col_c2, col_c3 = st.columns([2, 1, 1])
    with col_c1:
        target_sensor = st.selectbox("Select Target Road Sensor to Choke", sensors, index=0)
    with col_c2:
        drop_speed = st.slider("Target Speed (mph)", 5.0, 30.0, 12.0, step=1.0)
    with col_c3:
        st.markdown("<br>", unsafe_allow_html=True)
        if st.button("💥 Trigger Incident", use_container_width=True):
            st.session_state.sim_data = simulator.induce_incident(target_sensor, target_speed=drop_speed, duration_steps=4)
            st.rerun()
            
    sim_data = st.session_state.sim_data
    df_preds = sim_data.get("ai_predictions")
    
    if df_preds is not None:
        spillover_analysis = predictor.analyze_spillover(target_sensor, df_preds)
        
        col_g, col_chain = st.columns([3, 2])
        with col_g:
            st.markdown(f"**Network Impact Map (Origin: Sensor {target_sensor})**")
            fig_spill = render_network_graph(df_preds, highlighted_road=target_sensor, spillover_data=spillover_analysis, show_directional_edges=True)
            st.plotly_chart(fig_spill, use_container_width=True)
            
        with col_chain:
            st.markdown("#### 🌊 Inferred Cascade Chain")
            p_chain = spillover_analysis.get("propagation_chain", [])
            if p_chain:
                for step in p_chain:
                    st.markdown(f"""
                    <div class="chain-node" style="margin-bottom:8px;">
                        <div style="display:flex;justify-content:space-between;">
                            <b>Step {step['step']}: Road {step['road_id']}</b>
                            <span style="color:#38BDF8;font-size:0.85rem;">+{step['horizon_min']} min</span>
                        </div>
                        <div style="font-size:0.82rem;color:#94A3B8;margin-top:2px;">
                            Role: {step['role']} | Speed: {step['current_speed']:.1f} mph | Risk: {step['congestion_probability']*100:.1f}%
                        </div>
                        <div style="font-size:0.75rem;color:#A78BFA;margin-top:2px;">
                            Relation: {step['relation_to_prev']} ({step.get('confidence', 'Uncertain')})
                        </div>
                    </div>
                    """, unsafe_allow_html=True)
            else:
                st.info("No active cascade detected.")
                
        st.markdown("#### 🎯 Downstream Spillover Targets")
        targs = spillover_analysis.get("spillover_targets", [])
        if targs:
            df_table = pd.DataFrame([
                {
                    "Target Road": t["road_id"],
                    "Hop": t["hop_distance"],
                    "Est. Horizon": f"+{t['estimated_horizon_min']} min",
                    "Speed": f"{t['current_speed']:.1f} mph",
                    "Risk": f"{t['congestion_probability']*100:.1f}%",
                    "State": t["early_warning_state"],
                    "Direction Status": t["propagation_direction_label"],
                    "Confidence": t["propagation_confidence"],
                }
                for t in targs[:10]
            ])
            st.dataframe(df_table, use_container_width=True, hide_index=True)


