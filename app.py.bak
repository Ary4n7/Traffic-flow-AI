    with t_multi:
        st.markdown("### ⏱️ Direct Multi-Horizon Machine Learning vs Heuristic Projections")
        st.markdown("""
        Independently trained Random Forest models for each prediction horizon evaluated on the untouched chronological test set:
        - **5-min Horizon ($t+1$):** `speed(t + 5 min) < 20 mph`
        - **10-min Horizon ($t+2$):** `speed(t + 10 min) < 20 mph`
        - **15-min Horizon ($t+3$):** `speed(t + 15 min) < 20 mph`
        """)
        
        if multi_horizon_data:
            dm = multi_horizon_data["direct_models"]
            m_rows = []
            for h_k, h_v in dm.items():
                cal_m = h_v["calibrated_metrics"]
                m_rows.append({
                    "Prediction Horizon": f"+{h_v['horizon_minutes']} Minutes",
                    "Target Definition": h_v["target_definition"],
                    "Calibration Method": h_v["calibration_method"].capitalize(),
                    "Accuracy": f"{cal_m['accuracy']*100:.2f}%",
                    "Precision": f"{cal_m['precision']*100:.2f}%",
                    "Recall": f"{cal_m['recall']*100:.2f}%",
                    "F1-Score": f"{cal_m['f1_score']*100:.2f}%",
                    "ROC-AUC": f"{cal_m['roc_auc']*100:.2f}%",
                    "PR-AUC": f"{cal_m['pr_auc']*100:.2f}%",
                    "Brier Score": f"{cal_m['brier_score']:.4f}",
                    "ECE": f"{cal_m['ece']:.4f}",
                })
            st.dataframe(pd.DataFrame(m_rows), use_container_width=True, hide_index=True)
            
            st.markdown("#### 🔬 Direct ML Model vs Heuristic Projection Comparison")
            dvp = multi_horizon_data["direct_vs_projection_comparison"]
            c_rows = []
            for h_key, h_data in dvp.items():
                d = h_data["direct_model"]
                p = h_data["projection"]
                c_rows.append({
                    "Horizon": h_key.replace("_", " ").title(),
                    "Direct Model F1": f"{d['f1_score']*100:.2f}%",
                    "Projection F1": f"{p['f1_score']*100:.2f}%",
                    "F1 Gain": f"+{h_data['f1_improvement_pct']}%",
                    "Direct ROC-AUC": f"{d['roc_auc']:.4f}",
                    "Projection ROC-AUC": f"{p['roc_auc']:.4f}",
                    "Brier Improvement": f"{h_data['brier_improvement_pct']}% better",
                })
            st.table(pd.DataFrame(c_rows))
            
    # ── TAB 2: Threshold Optimization ──────────────────────────────────────────
    with t_thresh:
        st.markdown("### ⚖️ Validation-Driven Decision & Early-Warning Threshold Analysis")
        st.markdown("Thresholds tuned strictly on the chronological **Validation Set** to prevent test-set contamination, then benchmarked on the untouched **Test Set**.")
        
        if threshold_data:
            modes = threshold_data["selected_modes"]
            test_bm = threshold_data["test_set_benchmarks"]
            
            t_rows = []
            for m_key, m_info in modes.items():
                t_test = test_bm.get(m_key, {})
                t_rows.append({
                    "Operational Mode": m_info["name"],
                    "Selected Threshold": f"{m_info['selected_threshold']:.3f}",
                    "Test Accuracy": f"{t_test.get('accuracy', 0)*100:.2f}%",
                    "Test Precision": f"{t_test.get('precision', 0)*100:.2f}%",
                    "Test Recall": f"{t_test.get('recall', 0)*100:.2f}%",
                    "Test F1-Score": f"{t_test.get('f1_score', 0)*100:.2f}%",
                    "False Alarm Rate (FPR)": f"{t_test.get('false_positive_rate', 0)*100:.2f}%",
                    "Advance Warning Rate": f"{t_test.get('advance_warning_rate_pct', 0):.1f}%",
                    "Mean Warning Lead Time": f"{t_test.get('mean_lead_time_min', 0):.1f} min",
                })
            st.dataframe(pd.DataFrame(t_rows), use_container_width=True, hide_index=True)
            
            # Curve Visualization
            v_curve = pd.DataFrame(threshold_data["validation_curve"])
            fig_th = go.Figure()
            fig_th.add_trace(go.Scatter(x=v_curve["threshold"], y=v_curve["precision"], name="Validation Precision", line=dict(color="#38BDF8", width=2)))
            fig_th.add_trace(go.Scatter(x=v_curve["threshold"], y=v_curve["recall"], name="Validation Recall", line=dict(color="#F87171", width=2)))
            fig_th.add_trace(go.Scatter(x=v_curve["threshold"], y=v_curve["f1_score"], name="Validation F1-Score", line=dict(color="#22C55E", width=3)))
            fig_th.update_layout(
                title="Validation Operating Characteristics Curve (Precision-Recall-F1 vs Threshold)",
                xaxis=dict(title="Probability Threshold"),
                yaxis=dict(title="Metric Score", range=[0, 1]),
                plot_bgcolor="#1E293B", paper_bgcolor="#1E293B", font=dict(color="#F8FAFC"),
                height=350,
            )
            st.plotly_chart(fig_th, use_container_width=True)
            
    # ── TAB 3: Temporal Regimes ────────────────────────────────────────────────
    with t_reg:
        st.markdown("### 🌅 Diurnal & Temporal Regime Robustness")
        st.markdown("Evaluates system reliability across standard commute shockwaves, off-peak free-flow, and weekend travel.")
        
        if regime_data:
            regs = regime_data["regimes"]
            reg_rows = []
            for r_k, r_v in regs.items():
                reg_rows.append({
