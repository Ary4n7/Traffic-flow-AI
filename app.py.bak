# ── Helper: Render Network Graph ──────────────────────────────────────────────
def render_network_graph(df_predictions, highlighted_road=None, spillover_data=None, show_directional_edges=False):
    """Render interactive 2D road network with 5-state Early Warning coloring and directional indicators."""
    pred_map = df_predictions.set_index("road_id").to_dict(orient="index") if df_predictions is not None else {}
    
    edge_x_normal = []
    edge_y_normal = []
    edge_x_dir = []
    edge_y_dir = []
    
    edges_meta = prop_data.get("edges", {}) if prop_data else {}
    
    for u, v in G_network.edges():
        if u in graph_pos and v in graph_pos:
            x0, y0 = graph_pos[u]
            x1, y1 = graph_pos[v]
            
            is_dir = False
            if f"{u}->{v}" in edges_meta or f"{v}->{u}" in edges_meta:
                is_dir = True
                
            if show_directional_edges and is_dir:
                edge_x_dir.extend([x0, x1, None])
                edge_y_dir.extend([y0, y1, None])
            else:
                edge_x_normal.extend([x0, x1, None])
                edge_y_normal.extend([y0, y1, None])
                
    traces = []
    traces.append(go.Scatter(
        x=edge_x_normal, y=edge_y_normal,
        line=dict(width=0.7, color="#334155"),
        hoverinfo="none",
        mode="lines",
        name="Direction Uncertain / Proximity Edge",
    ))
    
    if edge_x_dir:
        traces.append(go.Scatter(
            x=edge_x_dir, y=edge_y_dir,
            line=dict(width=1.5, color="#38BDF8"),
            hoverinfo="none",
            mode="lines",
            name="Probable Propagation Direction Edge",
        ))
        
    node_x = []
    node_y = []
    node_color = []
    node_text = []
    node_size = []
    
    spillover_ids = {}
    if spillover_data and "spillover_targets" in spillover_data:
        for t in spillover_data["spillover_targets"]:
            spillover_ids[t["road_id"]] = t
            
    for node in G_network.nodes():
        x, y = graph_pos[node]
        node_x.append(x)
        node_y.append(y)
        
        info = pred_map.get(node, {})
        speed = float(info.get("current_speed", 60.0))
        prob = float(info.get("congestion_probability", 0.0))
        raw_prob = float(info.get("raw_rf_probability", prob))
        cal_prob = float(info.get("calibrated_probability", prob))
        state = info.get("early_warning_state", "NORMAL")
        raw_state = info.get("raw_early_warning_state", state)
        d10 = float(info.get("speed_delta_10", 0.0))
        trm = float(info.get("TRM", 0.0))
        scp = float(info.get("SCP", 0.0))
        psi = float(info.get("PSI", 0.0))
        
        if node == highlighted_road:
            node_color.append("#C084FC")
            node_size.append(18)
            status_desc = "TARGET / SOURCE ROAD"
        elif state == "CRITICAL":
            node_color.append("#EF4444")
            node_size.append(14)
            status_desc = f"CRITICAL ({'Congested <20 mph' if speed < config.CONGESTION_THRESHOLD_MPH else 'Extreme Risk >85%'})"
        elif node in spillover_ids and spillover_ids[node]["is_directional"] and spillover_ids[node]["risk_level"] in ["HIGH", "CRITICAL"]:
            node_color.append("#F97316")
            node_size.append(15)
            status_desc = f"PROBABLE SPILLOVER (+{spillover_ids[node]['estimated_horizon_min']} min, {spillover_ids[node]['propagation_confidence']} Conf)"
        elif state == "HIGH RISK":
            node_color.append("#F97316")
            node_size.append(13)
            status_desc = "HIGH RISK (70–85%)"
        elif state == "WARNING":
            node_color.append("#F59E0B")
            node_size.append(12)
            status_desc = "WARNING (50–70% or rapid deceleration)"
        elif state == "WATCH":
            node_color.append("#EAB308")
            node_size.append(11)
            status_desc = "WATCH (30–50% or early decay)"
        else:
            node_color.append("#22C55E")
            node_size.append(9)
            status_desc = "NORMAL FLOW"
            
        hover = (
            f"<b>Road Sensor:</b> {node}<br>"
            f"<b>Speed:</b> {speed:.1f} mph ({d10:+.1f} mph over 10m)<br>"
            f"<b>Stage 4 Risk:</b> {prob * 100:.1f}%<br>"
            f"<b>Stabilized State:</b> {state} (Raw: {raw_state})<br>"
            f"<b>Triad Indices:</b> TRM: {trm:.2f} | SCP: {scp:.2f} | PSI: {psi:.2f}<br>"
            f"<b>Classification:</b> {status_desc}"
        )
        node_text.append(hover)
        
    traces.append(go.Scatter(
        x=node_x, y=node_y,
        mode="markers",
        hoverinfo="text",
        text=node_text,
        marker=dict(
            color=node_color,
            size=node_size,
            line=dict(width=1.5, color="#0F172A"),
        ),
        name="Highway Sensor",
    ))
    
    fig = go.Figure(data=traces)
    fig.update_layout(
        showlegend=True,
        hovermode="closest",
        margin=dict(b=0, l=0, r=0, t=0),
        xaxis=dict(showgrid=False, zeroline=False, showticklabels=False),
        yaxis=dict(showgrid=False, zeroline=False, showticklabels=False),
        plot_bgcolor="#0B1120",
        paper_bgcolor="#0B1120",
        legend=dict(font=dict(color="#F8FAFC"), orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1),
        height=520,
    )
    return fig


