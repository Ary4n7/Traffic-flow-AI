                    "Precision": f"{m_val['precision']*100:.2f}%",
                    "Recall": f"{m_val['recall']*100:.2f}%",
                    "F1-Score": f"{m_val['f1_score']*100:.2f}%",
                    "ROC-AUC": f"{m_val['roc_auc']*100:.2f}%",
                    "Brier Score": f"{m_val['brier_score']:.4f}",
                    "FPR": f"{m_val['false_positive_rate']*100:.2f}%",
                    "Adv. Warning %": f"{lt.get('advance_rate_pct', 0)}%",
                    "Mean Lead": f"{lt.get('mean_lead_time_min', 0)}m",
